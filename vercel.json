{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node --version",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    },
    {
      "source": "/updates/latest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [],
  "rewrites": [
    {
      "source": "/download/windows",
      "destination": "/api/download?asset=installer"
    },
    {
      "source": "/download/runtime",
      "destination": "/api/download?asset=runtime"
    },
    {
      "source": "/download/checksums",
      "destination": "/api/download?asset=checksums"
    },
    {
      "source": "/updates/latest.json",
      "destination": "/api/update"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "includeFiles": "{release/**,site.config.json}"
    }
  }
}
